{
	"name": "hta-language-support",
	"displayName": "HTA Highlighting Support",
	"description": "Syntax highlighting for HTML Applications with CSS, JavaScript and VBScript",
	"version": "1.3.6",
	"publisher": "walkingsk",
	"engines": {
		"vscode": "^1.70.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onCommand:hta.toggleComment"
	],
	"icon": "media/HTA.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/walkingsk/hta-language-support.git"
	},
	"contributes": {
		"commands": [
			{
				"command": "hta.toggleComment",
				"title": "HTA: Toggle Comment"
			}
		],
		"keybindings": [
			{
				"command": "hta.toggleComment",
				"key": "ctrl+/",
				"mac": "cmd+/",
				"when": "editorLangId == hta && editorTextFocus && !editorReadonly"
			}
		],
		"languages": [
			{
				"id": "hta",
				"aliases": [
					"HTA",
					"HTML Application"
				],
				"extensions": [
					".hta"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"dark": "./media/hta_language.png",
					"light": "./media/hta_language.png"
				}
			}
		],
		"grammars": [
			{
				"language": "hta",
				"scopeName": "text.html.hta",
				"path": "./syntaxes/hta.tmLanguage.json"
			}
		],
		
		"semanticTokenScopes": [
			{
				"language": "hta",
				"scopes": {
					"stringLiteral": [
						"string.quoted.single.js",
						"string.quoted.double.js"
					]
				}
			}
		]
	}
}
